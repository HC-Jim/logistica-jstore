# URL del backend Express (sin /api ni barra final). Solo la usa el servidor de Next.js.
API_URL=http://localhost:4000

# Clave de navegador de Google Maps (Maps JavaScript API + Geocoding API).
# Restríngela por "HTTP referrers" a tu dominio.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID para marcadores avanzados (DEMO_MAP_ID sirve para desarrollo)
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID
