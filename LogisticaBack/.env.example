PORT=4000
NODE_ENV=development

# Neon (PostgreSQL). Para desarrollo usa una rama "dev", no la de producción.
# URL con pooler (el host contiene "-pooler"); incluye ?sslmode=require
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# URL directa (sin pooler), usada por `npm run migrate`
DATABASE_URL_UNPOOLED=postgresql://USUARIO:CLAVE@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full

APP_TIMEZONE=America/Lima

JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES_IN=8h

# Orígenes permitidos para CORS (separados por coma). Con el proxy de Next.js no suele hacer falta.
CORS_ORIGIN=http://localhost:3000

# Usuario administrador que se crea al ejecutar `npm run migrate` (si no existe)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@logistica.local
ADMIN_PASSWORD=admin123

# Clave de Google con "Routes API" habilitada (solo servidor, no exponer en el front)
GOOGLE_MAPS_SERVER_KEY=

# Punto de partida/llegada de las rutas (almacén)
DEPOSITO_NOMBRE=Almacén principal
DEPOSITO_LAT=-12.046374
DEPOSITO_LNG=-77.042793
